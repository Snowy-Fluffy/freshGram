using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";
using "chat_helpers/chat_helpers.style";

iconPickerSelectedPadding: 2px;
iconPickerSelectedRounding: 12px;
iconPickerImagePadding: 4px;
iconPickerIconSize: 64px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "ayu/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "ayu/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarPeek: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "menu/info", menuIconFg }};
	iconOver: icon {{ "menu/info", menuIconFgOver }};
	iconPosition: point(8px, 15px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}
topBarPeekMinNameWidth: 120px;

unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

ghostPickerArrow: icon{{ "info/edit/expand_arrow_small", windowActiveTextFg }};

ghostPickerButton: LinkButton(defaultLinkButton) {
	color: windowActiveTextFg;
	overColor: windowActiveTextFg;
	font: font(boxFontSize);
	overFont: font(boxFontSize);
}

ayuBetaBadgePadding: margins(4px, 1px, 4px, 1px);

ayuServiceTimeBadgeFont: font(11px semibold);
ayuServiceTimeBadgeHorizontalPadding: 7px;
ayuServiceTimeBadgeVerticalPadding: 2px;
ayuServiceTimeBadgeGap: 8px;
ayuServiceTimeBadgeTrailingInset: 3px;
ayuServiceTimeBadgeLastLineWidthAdd: 9px;

recognitionHandleRadius: 7px;
recognitionHandleTolerance: 16px;
recognitionBorder: 2px;
recognitionMinSide: 32px;
recognitionButtonsSkip: 12px;
recognitionButtonsBottom: 28px;
recognitionHintTop: 24px;
recognitionPanelRadius: 14px;
recognitionPanelPadding: margins(18px, 14px, 18px, 14px);
recognitionPanelMaxWidth: 640px;
recognitionPanelMaxHeight: 440px;
recognitionPanelMinWidth: 240px;
recognitionPanelMinHeight: 160px;
recognitionPanelMargin: 24px;
recognitionPanelButtonsTop: 12px;

historyStash: TwoIconButton(historyToDown) {
	iconAbove: icon {{ "history_stash_bubble-40x40", historyToDownFg, point(6px, 6px) }};
	iconAboveOver: icon {{ "history_stash_bubble-40x40", historyToDownFgOver, point(6px, 6px) }};
}
historyStashArrow: icon {{ "history_stash_arrow-40x40", historyToDownFg, point(6px, 6px) }};
historyStashArrowOver: icon {{ "history_stash_arrow-40x40", historyToDownFgOver, point(6px, 6px) }};
historyStashArrowClipPosition: point(18px, 28px);
historyStashArrowClipSize: size(16px, 12px);
historyStashArrowTravel: 12px;
historyStashBubbleTravel: 4px;

deleteOwnRowPadding: margins(22px, 4px, 22px, 4px);
deleteOwnNestedSkip: 36px;
deleteOwnFieldWidth: 120px;
storyPreviewHeight: 300px;
storyPreviewPadding: margins(0px, 12px, 0px, 12px);
storyPreviewRadius: 12px;
storyPreviewShade: 96;
storyProgressSize: 48px;
storyProgressLine: 3px;
storyAuthorUserpic: UserpicButton(defaultUserpicButton) {
	size: size(30px, 30px);
	photoSize: 30px;
}
storyAuthorUserpicLeft: 17px;

historyTranslateIconOn: icon {{ "chat/input_translate", windowActiveTextFg }};

historyTranslateButton: IconButton(historyAttach) {
	icon: icon {{ "chat/input_translate", historyComposeIconFg }};
	iconOver: icon {{ "chat/input_translate", historyComposeIconFgOver }};
}

boxCaptionTranslateButton: IconButton(historyTranslateButton) {
	width: 30px;
	height: 30px;
	rippleAreaSize: 0px;
}

fagramSliderHeight: 32px;
fagramCardInset: 16px;
fagramProfileCardInset: 8px;
fagramProfileTopSkip: 11px;
fagramMembersButtonWidth: 32px;
fagramMembersButtonsRight: 4px;
fagramDividerGap: 4px;
fagramDescriptionPadding: margins(22px, 4px, 22px, 8px);
fagramProfileCardSkip: 6px;

historyPluginsToggle: IconButton(historyAttach) {
	icon: icon {{ "menu/bot", historyComposeIconFg }};
	iconOver: icon {{ "menu/bot", historyComposeIconFgOver }};
}

pluginDangerLow: FlatLabel(boxDividerLabel) {
	textFg: boxTextFgGood;
}
pluginDangerMedium: FlatLabel(boxDividerLabel) {
	textFg: historyPeer8NameFg;
}
pluginDangerHigh: FlatLabel(boxDividerLabel) {
	textFg: attentionButtonFg;
}
pluginPermissionButtonBase: SettingsButton(settingsButtonNoIconLocked) {
	style: defaultTextStyle;
	textBg: transparent;
	textBgOver: transparent;
	padding: margins(68px, 8px, 22px, 8px);
	iconLeft: 17px;
}
pluginPermissionButtonStyleLow: DetailedSettingsButtonStyle(detailedSettingsButtonStyle) {
	button: SettingsButton(pluginPermissionButtonBase) {
		textFg: boxTextFgGood;
		textFgOver: boxTextFgGood;
	}
	description: FlatLabel(defaultFlatLabel) {
		textFg: boxTextFgGood;
	}
	iconPadding: 4px;
	iconForegroundPadding: 2px;
}
pluginPermissionButtonStyleMedium: DetailedSettingsButtonStyle(detailedSettingsButtonStyle) {
	button: SettingsButton(pluginPermissionButtonBase) {
		textFg: historyPeer8NameFg;
		textFgOver: historyPeer8NameFg;
	}
	description: FlatLabel(defaultFlatLabel) {
		textFg: historyPeer8NameFg;
	}
	iconPadding: 4px;
	iconForegroundPadding: 2px;
}
pluginPermissionButtonStyleHigh: DetailedSettingsButtonStyle(detailedSettingsButtonStyle) {
	button: SettingsButton(pluginPermissionButtonBase) {
		textFg: attentionButtonFg;
		textFgOver: attentionButtonFg;
	}
	description: FlatLabel(defaultFlatLabel) {
		textFg: attentionButtonFg;
	}
	iconPadding: 4px;
	iconForegroundPadding: 2px;
}

pluginLogBoxWidth: 760px;
pluginLogBoxHeight: 520px;
pluginLogTabsPadding: margins(12px, 0px, 12px, 0px);
pluginLogPadding: margins(16px, 8px, 16px, 8px);
pluginLogBottomSkip: 16px;
pluginLogConsole: FlatLabel(defaultFlatLabel) {
	minWidth: 200px;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
		lineHeight: 17px;
	}
}

pluginHeaderIconSize: 56px;
pluginHeaderIconRadius: 14px;
pluginHeaderSkip: 14px;
pluginHeaderLineSkip: 2px;
pluginHeaderLetterFont: font(24px semibold);
pluginHeaderTitle: FlatLabel(boxTitle) {
	minWidth: 120px;
	maxHeight: 0px;
}
pluginHeaderSubtitle: FlatLabel(boxDividerLabel) {
	minWidth: 120px;
}
pluginHeaderOfficial: FlatLabel(pluginHeaderSubtitle) {
	textFg: boxTextFgGood;
}
pluginHeaderUnofficial: FlatLabel(pluginHeaderSubtitle) {
	textFg: attentionButtonFg;
}
